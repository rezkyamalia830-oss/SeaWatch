# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt
npm-debug.log*

/.idea
/.ionic
/.sass-cache
/.sourcemaps
/.versions
/.vscode/*
!/.vscode/extensions.json
/coverage
/dist
/node_modules
/platforms
/plugins
/www


# Keystore dan kredensial signing Android
keystore.properties
*.jks
*.keystore

# File sensitif lainnya
.env
.env.*
!.env.example

# Dependensi dan hasil build
node_modules/
dist/
android/local.properties
android/.gradle/
android/**/build/